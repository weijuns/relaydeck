{
  "name": "relaydeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RelayDeck：AI 账号池与 OpenAI 兼容网关（不依赖 DeepSeek Harness 宿主）",
  "bin": {
    "relaydeck": "./src/index.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/index.mjs start",
    "login": "node src/index.mjs login",
    "accounts": "node src/index.mjs accounts",
    "models": "node src/index.mjs models",
    "status": "node src/index.mjs status",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" public/index.html",
    "format:check": "prettier --check \"src/**/*.mjs\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" public/index.html",
    "test": "node --test test/",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
